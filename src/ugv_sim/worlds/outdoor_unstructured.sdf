<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="outdoor_unstructured">

    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <!-- Sun Light with Outdoor Shadows -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0.5 0.5 0</pose>
      <diffuse>0.9 0.88 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1.0</direction>
    </light>

    <!-- Outdoor Skybox & Ambient Scene -->
    <scene>
      <ambient>0.6 0.65 0.7 1</ambient>
      <background>0.5 0.7 0.9 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Ground Plane (Dirt / Field Texture Simulation) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.30 0.22 1.0</ambient>
            <diffuse>0.45 0.38 0.28 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Natural Hazard Obstacle: Boulder 1 (Ahead on the trail) -->
    <model name="boulder_1">
      <static>true</static>
      <pose>4.0 0.2 0.35 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.9 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.9 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1.0</ambient>
            <diffuse>0.4 0.4 0.42 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Natural Hazard Obstacle: Boulder 2 (Offset right) -->
    <model name="boulder_2">
      <static>true</static>
      <pose>7.5 -1.2 0.5 0 0 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1.0</ambient>
            <diffuse>0.35 0.35 0.38 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Natural Hazard Obstacle: Mound / Slope (Tests terrain elevation gradient) -->
    <model name="terrain_mound_1">
      <static>true</static>
      <pose>10.0 1.5 0.4 0.3 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.5 2.0 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.5 2.0 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.18 1.0</ambient>
            <diffuse>0.4 0.32 0.22 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Natural Hazard Obstacle: Fallen Tree / Log -->
    <model name="fallen_log">
      <static>true</static>
      <pose>13.0 -0.5 0.25 0 1.5707 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>3.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>3.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.15 0.08 1.0</ambient>
            <diffuse>0.35 0.20 0.10 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Destination Landmark: Beacon / Post -->
    <model name="target_landmark">
      <static>true</static>
      <pose>18.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.9 0.2 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
