<?xml version='1.0' encoding='UTF-8'?>
<!--
  outdoor_field.sdf — Open Outdoor Terrain for Vision-Based UGV (Problem Statement World)
  ═══════════════════════════════════════════════════════════════════════════════════════
  Problem: Vision-Based Autonomous Navigation for UGV in Outdoor GPS-Denied Environment
  Challenges demonstrated: Path Detection · Visual Localization (SLAM) · Collision Avoidance

  ZERO FUEL/INTERNET DEPENDENCIES — all geometry is inline SDF primitives.

  ROBOT IS NOT IN THIS FILE.
  Localbot is spawned separately by sim.launch.py via ros_gz_sim create.

  WORLD NAME: "world_demo"
    Must match world_name launch argument (default='world_demo').

  DESIGN RATIONALE (maps directly to problem statement):
    1. PATH DETECTION  — rocks, trees, and terrain mounds are distributed to create
       clear hazard regions. YOLO classifies them; terrain_analysis_node marks
       traversability. The safe path is NOT marked — the UGV must detect it.
    2. VISUAL LOCALIZATION — trees, rocks, mounds, and colored goal/start markers
       provide rich, repeatable visual features for RTAB-Map SLAM loop closures.
    3. COLLISION AVOIDANCE — obstacles in and around the central path force Nav2 to
       plan dynamic detours; the barrel cluster and rock wall test costmap inflation.

  OUTDOOR FIELD LAYOUT (top-down, X=East, Y=North, unit=metre)
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  ∞ OPEN TERRAIN — no enclosing walls                                    │
  │                                                                         │
  │            ★ GOAL B  (0, +12)  [cyan pad + white post]                 │ Y=+12
  │                                                                         │
  │  🌳 tree        🪨 rock         🌳 tree                                  │ Y=+9
  │             🪨 rock_wall (forces detour)                                │ Y=+7
  │  🌳 tree                         🌳 tree                                 │ Y=+6
  │         🪨 rock  🪨 rock                                                │ Y=+4
  │  ████ mound_R (elevated terrain, tests terrain_analysis)    ████ mound_L│ Y=+3
  │           ──── ditch ridges ── (crossing challenge) ────               │ Y=+1
  │  🌳 tree        🪨 rock   🌳 tree                                        │ Y= 0
  │          🪨 rock cluster (3 boulders, centre-left)                      │ Y=-1
  │  🌳 tree                         🌳 tree                                 │ Y=-2
  │         🪨 rock           🪨 rock                                       │ Y=-4
  │  ████ mound_L (terrain mound)                                           │ Y=-3
  │                                                                         │
  │           ★ START A  (0, -6.5) [green pad, robot spawns here ↑]        │ Y=-6.5
  │                                                                         │
  │  ∞ open ground extends to the horizon                                   │
  └─────────────────────────────────────────────────────────────────────────┘
  X=-15                                                                X=+15

  SUGGESTED A→B NAVIGATION DEMO (after SLAM map builds):
    ros2 action send_goal /navigate_to_pose nav2_msgs/action/NavigateToPose \
      '{pose: {header: {frame_id: "map"}, pose: {position: {x: 0.0, y: 12.0, z: 0.0},
        orientation: {w: 1.0}}}}'

  OTHER TEST GOALS:
    NW detour:   x=-5.0, y=+8.0
    NE detour:   x=+5.0, y=+8.0
    Rock field:  x=+2.0, y=+3.0
    Ditch cross: x= 0.0, y=+2.5
-->
<sdf version='1.7'>
<world name='world_demo'>

  <!-- ════════════════════════════════════════════════════════════════
       PHYSICS & SYSTEM PLUGINS
       ════════════════════════════════════════════════════════════════ -->
  <gravity>0 0 -9.8</gravity>
  <physics type='ode'>
    <max_step_size>0.004</max_step_size>
    <real_time_factor>1</real_time_factor>
    <max_contacts>10</max_contacts>
  </physics>

  <plugin name='ignition::gazebo::systems::Physics'
          filename='libignition-gazebo-physics-system.so'/>
  <plugin name='ignition::gazebo::systems::UserCommands'
          filename='libignition-gazebo-user-commands-system.so'/>
  <plugin name='ignition::gazebo::systems::SceneBroadcaster'
          filename='libignition-gazebo-scene-broadcaster-system.so'/>
  <plugin name='ignition::gazebo::systems::Imu'
          filename='ignition-gazebo-imu-system'/>
  <plugin name='ignition::gazebo::systems::Sensors'
          filename='ignition-gazebo-sensors-system'>
    <render_engine>ogre2</render_engine>
  </plugin>

  <!-- ════════════════════════════════════════════════════════════════
       GUI
       ════════════════════════════════════════════════════════════════ -->
  <gui fullscreen="0">
    <plugin filename="GzScene3D" name="3D View">
      <ignition-gui>
        <title>3D View</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </ignition-gui>
      <engine>ogre2</engine>
      <scene>scene</scene>
      <ambient_light>0.4 0.4 0.4</ambient_light>
      <background_color>0.47 0.65 0.82</background_color>
      <!-- Camera: wide isometric view of the whole field from SE -->
      <camera_pose>10 -20 14 0 0.65 2.1</camera_pose>
    </plugin>

    <plugin filename="WorldControl" name="World control">
      <ignition-gui>
        <title>World control</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">72</property>
        <property type="double" key="width">121</property>
        <property type="double" key="z">1</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="left" target="left"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </ignition-gui>
      <play_pause>true</play_pause>
      <step>true</step>
      <start_paused>false</start_paused>
    </plugin>

    <plugin filename="WorldStats" name="World stats">
      <ignition-gui>
        <title>World stats</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">110</property>
        <property type="double" key="width">290</property>
        <property type="double" key="z">1</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="right" target="right"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </ignition-gui>
      <sim_time>true</sim_time>
      <real_time>true</real_time>
      <real_time_factor>true</real_time_factor>
      <iterations>true</iterations>
    </plugin>

    <plugin filename="TransformControl" name="Transform control">
      <ignition-gui>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="left" target="left"/>
          <line own="top" target="top"/>
        </anchors>
      </ignition-gui>
    </plugin>

    <plugin filename="EntityTree" name="Entity tree"/>

    <plugin filename="Teleop" name="Teleop">
      <ignition-gui>
        <property key="x" type="double">0</property>
        <property key="y" type="double">0</property>
        <property key="width" type="double">400</property>
        <property key="height" type="double">900</property>
        <property key="state" type="string">docked</property>
      </ignition-gui>
      <topic>/model/localbot/cmd_vel</topic>
    </plugin>
  </gui>

  <!-- ════════════════════════════════════════════════════════════════
       OUTDOOR SCENE & LIGHTING
       Open sky, natural sun angle, soft ambient fill
       ════════════════════════════════════════════════════════════════ -->
  <scene>
    <ambient>0.48 0.50 0.45 1</ambient>
    <background>0.47 0.65 0.82 1</background>  <!-- open sky blue -->
    <shadows>true</shadows>
    <grid>false</grid>
  </scene>

  <!-- Primary sun (morning angle) — casts directional shadows for depth cues -->
  <light type="directional" name="sun">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 20 0 0 0</pose>
    <diffuse>0.92 0.88 0.78 1</diffuse>
    <specular>0.25 0.22 0.18 1</specular>
    <direction>-0.5 0.3 -0.8</direction>
    <attenuation>
      <range>2000</range><constant>0.9</constant>
      <linear>0.001</linear><quadratic>0.0001</quadratic>
    </attenuation>
  </light>

  <!-- Sky fill — prevents harsh under-shadow blackout -->
  <light type="directional" name="sky_fill">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.38 0.45 0.55 1</diffuse>
    <specular>0.05 0.05 0.05 1</specular>
    <direction>0.1 -0.1 -1</direction>
  </light>

  <!-- ════════════════════════════════════════════════════════════════
       GROUND — grass-coloured, large open field
       ════════════════════════════════════════════════════════════════ -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <contact><ode/></contact>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        <material>
          <!-- Grass / dry-earth outdoor ground -->
          <ambient>0.42 0.50 0.28 1</ambient>
          <diffuse>0.45 0.52 0.30 1</diffuse>
          <specular>0.02 0.03 0.01 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       DIRT PATH — narrow traversable trail from A to B
       (visible to depth sensor and YOLO; slightly lighter than grass)
       ════════════════════════════════════════════════════════════════ -->
  <model name="path_S">
    <static>true</static><pose>0 -3.5 0.005 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>2.5 6.0 0.01</size></box></geometry>
        <material><ambient>0.62 0.55 0.38 1</ambient><diffuse>0.65 0.58 0.40 1</diffuse></material></visual>
    </link>
  </model>
  <model name="path_C">
    <static>true</static><pose>0 2.0 0.005 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>2.5 8.0 0.01</size></box></geometry>
        <material><ambient>0.62 0.55 0.38 1</ambient><diffuse>0.65 0.58 0.40 1</diffuse></material></visual>
    </link>
  </model>
  <model name="path_N">
    <static>true</static><pose>0 8.0 0.005 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>2.5 6.0 0.01</size></box></geometry>
        <material><ambient>0.62 0.55 0.38 1</ambient><diffuse>0.65 0.58 0.40 1</diffuse></material></visual>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       START MARKER A — bright green pad + white post
       ════════════════════════════════════════════════════════════════ -->
  <model name="start_pad">
    <static>true</static><pose>0 -6.5 0.01 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>3.0 2.0 0.02</size></box></geometry>
        <material><ambient>0.10 0.82 0.18 1</ambient><diffuse>0.12 0.85 0.20 1</diffuse></material></visual>
    </link>
  </model>
  <model name="start_post_L">
    <static>true</static><pose>-1.8 -6.5 0.7 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.08</radius><length>1.4</length></cylinder></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.08</radius><length>1.4</length></cylinder></geometry></collision>
    </link>
  </model>
  <model name="start_post_R">
    <static>true</static><pose>1.8 -6.5 0.7 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.08</radius><length>1.4</length></cylinder></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.08</radius><length>1.4</length></cylinder></geometry></collision>
    </link>
  </model>
  <!-- Flag banner between start posts -->
  <model name="start_banner">
    <static>true</static><pose>0 -6.5 1.42 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>3.7 0.05 0.35</size></box></geometry>
        <material><ambient>0.10 0.82 0.18 1</ambient><diffuse>0.12 0.85 0.20 1</diffuse></material></visual>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       GOAL MARKER B — cyan pad + white post + flag
       ════════════════════════════════════════════════════════════════ -->
  <model name="goal_pad">
    <static>true</static><pose>0 12.0 0.01 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>4.0 2.5 0.02</size></box></geometry>
        <material><ambient>0.05 0.82 0.90 1</ambient><diffuse>0.06 0.85 0.92 1</diffuse></material></visual>
    </link>
  </model>
  <model name="goal_post_L">
    <static>true</static><pose>-2.2 12.0 0.9 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.10</radius><length>1.8</length></cylinder></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.10</radius><length>1.8</length></cylinder></geometry></collision>
    </link>
  </model>
  <model name="goal_post_R">
    <static>true</static><pose>2.2 12.0 0.9 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.10</radius><length>1.8</length></cylinder></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.10</radius><length>1.8</length></cylinder></geometry></collision>
    </link>
  </model>
  <model name="goal_banner">
    <static>true</static><pose>0 12.0 1.88 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>4.6 0.05 0.40</size></box></geometry>
        <material><ambient>0.05 0.82 0.90 1</ambient><diffuse>0.06 0.85 0.92 1</diffuse></material></visual>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       ROCKS / BOULDERS — natural grey, irregular sizes
       Each at ground level (z = radius so sphere sits on ground)
       ════════════════════════════════════════════════════════════════ -->

  <!-- Rock macros: rock_NN at (x, y, z=half_height) with random yaw rotation -->

  <!-- Approach zone rocks (y=-5 to -2) -->
  <model name="rock_01">
    <static>true</static><pose>-3.5 -4.5 0.45 0 0 0.7</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.50</radius></sphere></geometry>
        <material><ambient>0.42 0.40 0.37 1</ambient><diffuse>0.44 0.42 0.38 1</diffuse><specular>0.08 0.08 0.07 1</specular></material></visual>
      <collision name="c"><geometry><sphere><radius>0.50</radius></sphere></collision>
    </link>
  </model>
  <model name="rock_02">
    <static>true</static><pose>3.2 -3.8 0.35 0 0.1 1.2</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.9 0.7 0.70</size></box></geometry>
        <material><ambient>0.48 0.46 0.42 1</ambient><diffuse>0.50 0.48 0.44 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.9 0.7 0.70</size></box></geometry></collision>
    </link>
  </model>
  <model name="rock_03">
    <static>true</static><pose>5.5 -5.0 0.30 0.1 0 0.4</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.38</radius></sphere></geometry>
        <material><ambient>0.40 0.38 0.35 1</ambient><diffuse>0.42 0.40 0.36 1</diffuse></material></visual>
      <collision name="c"><geometry><sphere><radius>0.38</radius></sphere></collision>
    </link>
  </model>

  <!-- Central obstacle cluster — left of path (y=-1 to +1): rocks force path right -->
  <model name="rock_04">
    <static>true</static><pose>-1.8 -1.5 0.55 0 0 0.3</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.60</radius></sphere></geometry>
        <material><ambient>0.45 0.43 0.40 1</ambient><diffuse>0.47 0.45 0.41 1</diffuse><specular>0.10 0.10 0.08 1</specular></material></visual>
      <collision name="c"><geometry><sphere><radius>0.60</radius></sphere></collision>
    </link>
  </model>
  <model name="rock_05">
    <static>true</static><pose>-2.8 -0.5 0.40 0 0 1.0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.0 0.8 0.80</size></box></geometry>
        <material><ambient>0.43 0.42 0.38 1</ambient><diffuse>0.46 0.44 0.40 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>1.0 0.8 0.80</size></box></geometry></collision>
    </link>
  </model>
  <model name="rock_06">
    <static>true</static><pose>-1.0 0.8 0.35 0 0 0.8</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.38</radius></sphere></geometry>
        <material><ambient>0.40 0.38 0.35 1</ambient><diffuse>0.42 0.40 0.36 1</diffuse></material></visual>
      <collision name="c"><geometry><sphere><radius>0.38</radius></sphere></collision>
    </link>
  </model>

  <!-- Rock on right side of path forcing nav planning -->
  <model name="rock_07">
    <static>true</static><pose>2.5 0.5 0.45 0 0 0.6</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.50</radius></sphere></geometry>
        <material><ambient>0.46 0.44 0.41 1</ambient><diffuse>0.48 0.46 0.42 1</diffuse></material></visual>
      <collision name="c"><geometry><sphere><radius>0.50</radius></sphere></collision>
    </link>
  </model>

  <!-- Upper zone rocks (y=+3 to +7) -->
  <model name="rock_08">
    <static>true</static><pose>-3.2 3.5 0.50 0 0 0.2</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.55</radius></sphere></geometry>
        <material><ambient>0.44 0.42 0.38 1</ambient><diffuse>0.46 0.44 0.40 1</diffuse></material></visual>
      <collision name="c"><geometry><sphere><radius>0.55</radius></sphere></collision>
    </link>
  </model>
  <model name="rock_09">
    <static>true</static><pose>4.0 4.5 0.35 0.05 0 1.5</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.8 0.6 0.70</size></box></geometry>
        <material><ambient>0.47 0.45 0.41 1</ambient><diffuse>0.49 0.47 0.43 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.8 0.6 0.70</size></box></geometry></collision>
    </link>
  </model>
  <model name="rock_10">
    <static>true</static><pose>-1.5 6.5 0.45 0 0 0.9</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.50</radius></sphere></geometry>
        <material><ambient>0.43 0.41 0.38 1</ambient><diffuse>0.45 0.43 0.39 1</diffuse></material></visual>
      <collision name="c"><geometry><sphere><radius>0.50</radius></sphere></collision>
    </link>
  </model>
  <model name="rock_11">
    <static>true</static><pose>2.8 7.0 0.30 0 0 0.3</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.35</radius></sphere></geometry>
        <material><ambient>0.42 0.40 0.37 1</ambient><diffuse>0.44 0.42 0.38 1</diffuse></material></visual>
      <collision name="c"><geometry><sphere><radius>0.35</radius></sphere></collision>
    </link>
  </model>

  <!-- Rock wall blocking shortcut at y=+7 — forces path around -->
  <model name="rock_wall_A">
    <static>true</static><pose>0 7.5 0.45 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.9 0.7 0.90</size></box></geometry>
        <material><ambient>0.46 0.44 0.40 1</ambient><diffuse>0.48 0.46 0.42 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.9 0.7 0.90</size></box></geometry></collision>
    </link>
  </model>
  <model name="rock_wall_B">
    <static>true</static><pose>1.2 7.2 0.35 0 0.1 0.5</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.42</radius></sphere></geometry>
        <material><ambient>0.44 0.42 0.39 1</ambient><diffuse>0.46 0.44 0.40 1</diffuse></material></visual>
      <collision name="c"><geometry><sphere><radius>0.42</radius></sphere></collision>
    </link>
  </model>
  <model name="rock_wall_C">
    <static>true</static><pose>-1.3 7.6 0.30 0 0 0.9</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.7 0.5 0.60</size></box></geometry>
        <material><ambient>0.45 0.43 0.40 1</ambient><diffuse>0.47 0.45 0.41 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.7 0.5 0.60</size></box></geometry></collision>
    </link>
  </model>

  <!-- Far-field rocks (beyond goal, distant SLAM features) -->
  <model name="rock_far_L">
    <static>true</static><pose>-8 10 0.45 0 0 0.4</pose>
    <link name="link">
      <visual name="v"><geometry><sphere><radius>0.55</radius></sphere></geometry>
        <material><ambient>0.44 0.42 0.38 1</ambient><diffuse>0.46 0.44 0.40 1</diffuse></material></visual>
      <collision name="c"><geometry><sphere><radius>0.55</radius></sphere></collision>
    </link>
  </model>
  <model name="rock_far_R">
    <static>true</static><pose>8 9 0.40 0 0 1.1</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.8 0.6 0.80</size></box></geometry>
        <material><ambient>0.46 0.44 0.41 1</ambient><diffuse>0.48 0.46 0.42 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.8 0.6 0.80</size></box></geometry></collision>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       TREES — trunk (cylinder) + foliage (sphere)
       Rich visual SLAM landmarks; collision on trunk only
       ════════════════════════════════════════════════════════════════ -->

  <!-- Southern tree line (flanks approach zone) -->
  <model name="tree_01">
    <static>true</static><pose>-5.5 -5.0 0 0 0 0</pose>
