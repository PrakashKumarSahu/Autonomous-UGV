<?xml version='1.0' encoding='ASCII'?>
<!--
  ugv_test_arena.sdf — Project-native test world for Autonomous UGV
  ═══════════════════════════════════════════════════════════════════════════
  ZERO FUEL/INTERNET DEPENDENCIES:
    Ground plane, all obstacles, and lighting are inline SDF primitives.

  ROBOT IS NOT IN THIS FILE.
  Localbot is spawned separately by sim.launch.py using ros_gz_sim create.
  This keeps the world fully reusable for any robot configuration.

  WORLD NAME: "world_demo"
    Must match the world_name launch argument in sim.launch.py (default='world_demo').
    All GZ sensor topic paths use this name. Change via:
      ros2 launch ugv_bringup ugv_complete.launch.py world_name:=<your_name>
    (as long as this file's <world name="..."> also matches)

  TEST ARENA LAYOUT (top-down, X=East, Y=North):
    ┌──────────────────────────────────────────────────────────────┐
    │ NORTH WALL                                                    │ Y=+8
    │                                                               │
    │  [Cyl_NW]       ████████████ Shelf Wall █████████   [Cyl_NE] │ Y=+5
    │   (-4.5,5)          (0, 5.2) 6m long              (4.5,5)   │
    │                                                               │
    │   [Box_L2]    open aisle (~7m)               [Box_R2]        │ Y=+2
    │   (-6.5,2)                                     (6.5,2)       │
    │                                                               │
    │         [Cyl_CL]  [Box_C (red)]  [Cyl_CR]                   │ Y=-0.5
    │          (-3.5,0)   (0,-0.5)       (3.5,0)                   │
    │                                                               │
    │   [Box_L1]                                   [Box_R1]        │ Y=-3
    │   (-4,-3)                                     (4,-3)          │
    │                                                               │
    │              [Box_Start]      <- first obstacle               │ Y=-5
    │              (2.5,-5)                                         │
    │    ROBOT SPAWNS HERE (0,-6.5,yaw=π/2) via sim.launch.py ↑   │ Y=-6.5
    │ SOUTH WALL                                                    │ Y=-8
    └──────────────────────────────────────────────────────────────┘
    X=-10                                                         X=+10

  SUGGESTED NAVIGATION TEST GOALS (after SLAM map builds):
    ros2 action send_goal /navigate_to_pose nav2_msgs/action/NavigateToPose \
      '{pose: {header: {frame_id: "map"}, pose: {position: {x: 0.0, y: 6.0, z: 0.0}, orientation: {w: 1.0}}}}'

    Goal A: x=0,  y=6   — north through all 5 obstacle rows
    Goal B: x=-7, y=5   — NW side corridor
    Goal C: x=7,  y=5   — NE side (near L-wall pocket)
    Goal D: x=0,  y=0   — arena center (zigzag section)
-->
<sdf version='1.7'>
<world name='world_demo'>

  <!-- ══════════════════════════════════════════════════════════════════
       PHYSICS & SYSTEM PLUGINS
       ══════════════════════════════════════════════════════════════════ -->
  <gravity>0 0 -9.8</gravity>
  <physics type='ode'>
    <max_step_size>0.004</max_step_size>   <!-- 250 Hz physics — stable for diff-drive wheels -->
    <real_time_factor>1</real_time_factor>
    <max_contacts>10</max_contacts>
  </physics>

  <plugin name='ignition::gazebo::systems::Physics'
          filename='libignition-gazebo-physics-system.so'/>
  <plugin name='ignition::gazebo::systems::UserCommands'
          filename='libignition-gazebo-user-commands-system.so'/>
  <plugin name='ignition::gazebo::systems::SceneBroadcaster'
          filename='libignition-gazebo-scene-broadcaster-system.so'/>

  <!-- IMU system — MUST be at world level (processes all imu sensor entities) -->
  <plugin name='ignition::gazebo::systems::Imu'
          filename='ignition-gazebo-imu-system'/>

  <!-- Sensors system — MUST be at world level.
       ogre2: required for depth_camera in Gazebo Harmonic; ogre v1 does NOT support it. -->
  <plugin name='ignition::gazebo::systems::Sensors'
          filename='ignition-gazebo-sensors-system'>
    <render_engine>ogre2</render_engine>
  </plugin>

  <!-- ══════════════════════════════════════════════════════════════════
       GUI
       ══════════════════════════════════════════════════════════════════ -->
  <gui fullscreen="0">

    <plugin filename="GzScene3D" name="3D View">
      <ignition-gui>
        <title>3D View</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </ignition-gui>
      <engine>ogre2</engine>
      <scene>scene</scene>
      <ambient_light>0.4 0.4 0.4</ambient_light>
      <background_color>0.6 0.7 0.9</background_color>
      <!-- Camera: overview from south-west, looking north-east across arena -->
      <camera_pose>-5 -14 10 0 0.65 1.3</camera_pose>
    </plugin>

    <plugin filename="WorldControl" name="World control">
      <ignition-gui>
        <title>World control</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">72</property>
        <property type="double" key="width">121</property>
        <property type="double" key="z">1</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="left" target="left"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </ignition-gui>
      <play_pause>true</play_pause>
      <step>true</step>
      <!-- NOT paused: sensors need to start immediately for camera/depth data -->
      <start_paused>false</start_paused>
    </plugin>

    <plugin filename="WorldStats" name="World stats">
      <ignition-gui>
        <title>World stats</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">110</property>
        <property type="double" key="width">290</property>
        <property type="double" key="z">1</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="right" target="right"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </ignition-gui>
      <sim_time>true</sim_time>
      <real_time>true</real_time>
      <real_time_factor>true</real_time_factor>
      <iterations>true</iterations>
    </plugin>

    <plugin filename="TransformControl" name="Transform control">
      <ignition-gui>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="left" target="left"/>
          <line own="top" target="top"/>
        </anchors>
      </ignition-gui>
    </plugin>

    <plugin filename="EntityTree" name="Entity tree"/>

    <!-- Teleop widget — keyboard/slider control from Gazebo GUI.
         Topic matches the default robot_name (localbot).
         If robot_name launch arg is changed, update this topic accordingly. -->
    <plugin filename="Teleop" name="Teleop">
      <ignition-gui>
        <property key="x" type="double">0</property>
        <property key="y" type="double">0</property>
        <property key="width" type="double">400</property>
        <property key="height" type="double">900</property>
        <property key="state" type="string">docked</property>
      </ignition-gui>
      <topic>/model/localbot/cmd_vel</topic>
    </plugin>

  </gui>

  <!-- ══════════════════════════════════════════════════════════════════
       SCENE & LIGHTING
       ══════════════════════════════════════════════════════════════════ -->
  <scene>
    <ambient>0.6 0.6 0.6 1</ambient>
    <background>0.6 0.7 0.9 1</background>
    <shadows>0</shadows>
    <grid>false</grid>
  </scene>

  <light type="directional" name="sun">
    <cast_shadows>0</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>1 1 1 1</diffuse>
    <specular>0.3 0.3 0.3 1</specular>
    <direction>-0.5 0.1 -0.9</direction>
    <attenuation>
      <range>1000</range><constant>0.9</constant>
      <linear>0.01</linear><quadratic>0.001</quadratic>
    </attenuation>
  </light>

  <light type="directional" name="fill_light">
    <cast_shadows>0</cast_shadows>
    <pose>0 0 8 0 0 0</pose>
    <diffuse>0.5 0.5 0.5 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular>
    <direction>0 0 -1</direction>
  </light>

  <!-- ══════════════════════════════════════════════════════════════════
       GROUND PLANE (inline — no Fuel dependency)
       ══════════════════════════════════════════════════════════════════ -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>200 200</size></plane>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><ode/></contact>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane><normal>0 0 1</normal><size>200 200</size></plane>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <!-- ══════════════════════════════════════════════════════════════════
       PERIMETER WALLS — Arena: 20m (X: -10..+10) × 16m (Y: -8..+8)
       ══════════════════════════════════════════════════════════════════ -->
  <model name="wall_south">
    <static>true</static><pose>0 -8 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>20.6 0.3 2.5</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>20.6 0.3 2.5</size></box></geometry></collision>
    </link>
  </model>
  <model name="wall_north">
    <static>true</static><pose>0 8 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>20.6 0.3 2.5</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>20.6 0.3 2.5</size></box></geometry></collision>
    </link>
  </model>
  <model name="wall_west">
    <static>true</static><pose>-10 0 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 16.6 2.5</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 16.6 2.5</size></box></geometry></collision>
    </link>
  </model>
  <model name="wall_east">
    <static>true</static><pose>10 0 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 16.6 2.5</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 16.6 2.5</size></box></geometry></collision>
    </link>
  </model>

  <!-- ══════════════════════════════════════════════════════════════════
       TEST OBSTACLES — 5 rows, navigable with Smac2D + RPP
       ══════════════════════════════════════════════════════════════════ -->

  <!-- Row 1 (y=-5): First obstacle just ahead of robot spawn -->
  <model name="obs_box_start">
    <static>true</static><pose>2.5 -5.0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
        <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
    </link>
  </model>

  <!-- Row 2 (y=-3): Dual gate — forces center navigation -->
  <model name="obs_box_L1">
    <static>true</static><pose>-4.0 -3.0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
        <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
    </link>
  </model>
  <model name="obs_box_R1">
    <static>true</static><pose>4.0 -3.0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
        <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
    </link>
  </model>

  <!-- Row 3 (y=0): Zigzag — blue cylinders + red center box -->
  <model name="obs_cyl_CL">
    <static>true</static><pose>-3.5 0.0 0.75 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.5</length></cylinder></geometry>
        <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.5</length></cylinder></geometry></collision>
    </link>
  </model>
  <model name="obs_box_C">
    <static>true</static><pose>0.0 -0.5 0.75 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.2 1.2 1.5</size></box></geometry>
        <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>1.2 1.2 1.5</size></box></geometry></collision>
    </link>
  </model>
  <model name="obs_cyl_CR">
    <static>true</static><pose>3.5 0.0 0.75 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.5</length></cylinder></geometry>
        <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.5</length></cylinder></geometry></collision>
    </link>
  </model>

  <!-- Row 4 (y=+2): Green side shapers — create center corridor -->
  <model name="obs_box_L2">
    <static>true</static><pose>-6.5 2.0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.5 2.0 1.0</size></box></geometry>
        <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>1.5 2.0 1.0</size></box></geometry></collision>
    </link>
  </model>
  <model name="obs_box_R2">
    <static>true</static><pose>6.5 2.0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.5 2.0 1.0</size></box></geometry>
        <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>1.5 2.0 1.0</size></box></geometry></collision>
    </link>
  </model>

  <!-- Row 5 (y=+5): Shelf wall + orange cylinders — final bottleneck -->
  <model name="obs_shelf_wall">
    <static>true</static><pose>0.0 5.2 1.0 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>6.0 0.3 2.0</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>6.0 0.3 2.0</size></box></geometry></collision>
    </link>
  </model>
  <model name="obs_cyl_NW">
    <static>true</static><pose>-4.5 5.0 0.75 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.45</radius><length>1.5</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.45</radius><length>1.5</length></cylinder></geometry></collision>
    </link>
  </model>
  <model name="obs_cyl_NE">
    <static>true</static><pose>4.5 5.0 0.75 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.45</radius><length>1.5</length></cylinder></geometry>
        <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.45</radius><length>1.5</length></cylinder></geometry></collision>
    </link>
  </model>

  <!-- L-shaped wall pocket in NE corner — tests concave space planning -->
  <model name="obs_L_arm1">
    <static>true</static><pose>7.5 4.5 1.0 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 4.0 2.0</size></box></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 4.0 2.0</size></box></geometry></collision>
    </link>
  </model>
  <model name="obs_L_arm2">
    <static>true</static><pose>6.1 2.6 1.0 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>3.0 0.3 2.0</size></box></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>3.0 0.3 2.0</size></box></geometry></collision>
    </link>
  </model>

  <!-- Purple cluster in SW — adds visual features for RTAB-Map in that corner -->
  <model name="obs_cluster_A"><static>true</static><pose>-7.0 -1.5 0.4 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
        <material><ambient>0.4 0.2 0.6 1</ambient><diffuse>0.4 0.2 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
    </link>
  </model>
  <model name="obs_cluster_B"><static>true</static><pose>-7.0 -2.5 0.3 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        <material><ambient>0.4 0.2 0.6 1</ambient><diffuse>0.4 0.2 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
    </link>
  </model>
  <model name="obs_cluster_C"><static>true</static><pose>-8.0 -2.0 0.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.8 0.4 0.5</size></box></geometry>
        <material><ambient>0.4 0.2 0.6 1</ambient><diffuse>0.4 0.2 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>1.8 0.4 0.5</size></box></geometry></collision>
    </link>
  </model>

  <!-- ══════════════════════════════════════════════════════════════════
       NOTE: Localbot robot NOT included here.
       Robot is spawned dynamically by sim.launch.py using ros_gz_sim create.
       This makes the world reusable for any robot or spawn configuration.
       ══════════════════════════════════════════════════════════════════ -->

</world>
</sdf>
