<?xml version='1.0' encoding='UTF-8'?>
<!--
  ugv_test_arena.sdf — Autonomous UGV Showcase Arena (Enhanced)
  ═══════════════════════════════════════════════════════════════════════════
  ZERO FUEL/INTERNET DEPENDENCIES:
    Ground plane, all obstacles, and lighting are inline SDF primitives.

  ROBOT IS NOT IN THIS FILE.
  Localbot is spawned separately by sim.launch.py using ros_gz_sim create.
  This keeps the world fully reusable for any robot configuration.

  WORLD NAME: "world_demo"
    Must match the world_name launch argument in sim.launch.py (default='world_demo').
    All GZ sensor topic paths use this name. Change via:
      ros2 launch ugv_bringup ugv_complete.launch.py world_name=<your_name>
    (as long as this file's <world name="..."> also matches)

  SHOWCASE ARENA LAYOUT  (top-down, X=East Y=North  unit=metre):
  ┌────────────────────────────────────────────────────────────────────┐Y=+8
  │ NORTH WALL  [BLUE panels]                                          │
  │  ◉ landmark_N_W        ┌────── GOAL ZONE ──────┐        ◉ landmark_N_E
  │  (-8,+7)               │ [CYAN floor tile]      │        (+8,+7)     │Y=+6
  │                        └────────────────────────┘                    │
  │  ████ corridor_wall_L  (━━━━ 1.8m passage ━━━━) corridor_wall_R ████│Y=+4
  │         ▲ barrel farm (6,3.5)                                        │
  │  [obs_box_L2 GREEN]    arc_gate_L  arc_gate_R  [obs_box_R2 GREEN]   │Y=+2
  │                                                                      │
  │   ◯Cyl_CL BLUE   ██ obs_box_C RED   ◯ Cyl_CR BLUE                  │Y= 0
  │      diagonal_blocker (NW)  ·  side_pillar_SE (SE)                  │
  │                                                                      │
  │  [obs_box_L1 YELLOW]   ◯slalom_mid_L  ◯slalom_mid_R  [obs_box_R1] │Y=-3
  │                    ◯ STEP PLATFORM (terrain test)                    │
  │              [obs_box_start ORANGE] [obs_box_L0 PURPLE]              │Y=-5
  │  ▲ spawn_post_L (-1.5,-7)      ▲ spawn_post_R (1.5,-7)             │Y=-7
  │    ROBOT SPAWNS HERE (0,-6.5,yaw=π/2 facing north)                  │
  │ SOUTH WALL  [ORANGE panels]                                          │
  └────────────────────────────────────────────────────────────────────┘Y=-8
  X=-10                                                              X=+10

  SUGGESTED NAVIGATION TEST GOALS (after SLAM map builds):
    Goal A — straight north:  x= 0.0, y=+6.5  (all zones, 13 m)
    Goal B — NW corner loop:  x=-7.0, y=+5.0
    Goal C — NE corridor:     x=+7.0, y=+5.0  (barrel farm side)
    Goal D — center zigzag:   x= 0.0, y= 0.0
    Goal E — SW side pocket:  x=-7.5, y=-2.0
    Goal F — step platform:   x= 0.0, y=-4.0  (terrain analysis)
-->
<sdf version='1.7'>
<world name='world_demo'>

  <!-- ════════════════════════════════════════════════════════════════
       PHYSICS & SYSTEM PLUGINS
       ════════════════════════════════════════════════════════════════ -->
  <gravity>0 0 -9.8</gravity>
  <physics type='ode'>
    <max_step_size>0.004</max_step_size>
    <real_time_factor>1</real_time_factor>
    <max_contacts>10</max_contacts>
  </physics>

  <plugin name='ignition::gazebo::systems::Physics'
          filename='libignition-gazebo-physics-system.so'/>
  <plugin name='ignition::gazebo::systems::UserCommands'
          filename='libignition-gazebo-user-commands-system.so'/>
  <plugin name='ignition::gazebo::systems::SceneBroadcaster'
          filename='libignition-gazebo-scene-broadcaster-system.so'/>
  <plugin name='ignition::gazebo::systems::Imu'
          filename='ignition-gazebo-imu-system'/>
  <plugin name='ignition::gazebo::systems::Sensors'
          filename='ignition-gazebo-sensors-system'>
    <render_engine>ogre2</render_engine>
  </plugin>

  <!-- ════════════════════════════════════════════════════════════════
       GUI
       ════════════════════════════════════════════════════════════════ -->
  <gui fullscreen="0">
    <plugin filename="GzScene3D" name="3D View">
      <ignition-gui>
        <title>3D View</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
      </ignition-gui>
      <engine>ogre2</engine>
      <scene>scene</scene>
      <ambient_light>0.5 0.5 0.5</ambient_light>
      <background_color>0.53 0.67 0.88</background_color>
      <!-- Camera: isometric overview of entire arena -->
      <camera_pose>-4 -16 12 0 0.60 1.25</camera_pose>
    </plugin>

    <plugin filename="WorldControl" name="World control">
      <ignition-gui>
        <title>World control</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">72</property>
        <property type="double" key="width">121</property>
        <property type="double" key="z">1</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="left" target="left"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </ignition-gui>
      <play_pause>true</play_pause>
      <step>true</step>
      <start_paused>false</start_paused>
    </plugin>

    <plugin filename="WorldStats" name="World stats">
      <ignition-gui>
        <title>World stats</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="bool" key="resizable">false</property>
        <property type="double" key="height">110</property>
        <property type="double" key="width">290</property>
        <property type="double" key="z">1</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="right" target="right"/>
          <line own="bottom" target="bottom"/>
        </anchors>
      </ignition-gui>
      <sim_time>true</sim_time>
      <real_time>true</real_time>
      <real_time_factor>true</real_time_factor>
      <iterations>true</iterations>
    </plugin>

    <plugin filename="TransformControl" name="Transform control">
      <ignition-gui>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="left" target="left"/>
          <line own="top" target="top"/>
        </anchors>
      </ignition-gui>
    </plugin>

    <plugin filename="EntityTree" name="Entity tree"/>

    <plugin filename="Teleop" name="Teleop">
      <ignition-gui>
        <property key="x" type="double">0</property>
        <property key="y" type="double">0</property>
        <property key="width" type="double">400</property>
        <property key="height" type="double">900</property>
        <property key="state" type="string">docked</property>
      </ignition-gui>
      <topic>/model/localbot/cmd_vel</topic>
    </plugin>
  </gui>

  <!-- ════════════════════════════════════════════════════════════════
       SCENE & LIGHTING
       ════════════════════════════════════════════════════════════════ -->
  <scene>
    <ambient>0.5 0.5 0.5 1</ambient>
    <background>0.53 0.67 0.88 1</background>
    <shadows>true</shadows>
    <grid>false</grid>
  </scene>

  <!-- Primary sunlight — angled for good shadow contrast -->
  <light type="directional" name="sun">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 15 0 0 0</pose>
    <diffuse>0.9 0.88 0.82 1</diffuse>
    <specular>0.3 0.3 0.3 1</specular>
    <direction>-0.4 0.2 -0.9</direction>
    <attenuation>
      <range>1000</range><constant>0.9</constant>
      <linear>0.01</linear><quadratic>0.001</quadratic>
    </attenuation>
  </light>

  <!-- Soft fill — eliminates harsh shadow undercuts -->
  <light type="directional" name="fill_light">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 8 0 0 0</pose>
    <diffuse>0.45 0.50 0.55 1</diffuse>
    <specular>0.05 0.05 0.05 1</specular>
    <direction>0.2 -0.1 -1</direction>
  </light>

  <!-- Warm point light — north end (goal zone ambiance) -->
  <light type="point" name="point_north">
    <cast_shadows>false</cast_shadows>
    <pose>0 6 3.5 0 0 0</pose>
    <diffuse>1.0 0.85 0.60 1</diffuse>
    <specular>0.3 0.25 0.15 1</specular>
    <attenuation>
      <range>12</range><constant>0.4</constant>
      <linear>0.1</linear><quadratic>0.02</quadratic>
    </attenuation>
  </light>

  <!-- Cool point light — south end (start zone ambiance) -->
  <light type="point" name="point_south">
    <cast_shadows>false</cast_shadows>
    <pose>0 -6 3.5 0 0 0</pose>
    <diffuse>0.65 0.78 1.0 1</diffuse>
    <specular>0.2 0.25 0.35 1</specular>
    <attenuation>
      <range>10</range><constant>0.5</constant>
      <linear>0.12</linear><quadratic>0.02</quadratic>
    </attenuation>
  </light>

  <!-- ════════════════════════════════════════════════════════════════
       GROUND PLANE — warm concrete tile texture via material
       ════════════════════════════════════════════════════════════════ -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><ode/></contact>
        </surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        <material>
          <ambient>0.70 0.68 0.62 1</ambient>
          <diffuse>0.70 0.68 0.62 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       FLOOR ZONE TILES — colored guide lanes for visual richness
       Each tile is 0.02 m tall so it's traversable but visible in depth.
       ════════════════════════════════════════════════════════════════ -->

  <!-- START ZONE: deep charcoal "launch pad" at robot spawn -->
  <model name="floor_start_zone">
    <static>true</static><pose>0 -6.5 0.01 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>4.0 2.5 0.02</size></box></geometry>
        <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
  </model>

  <!-- CENTRAL CORRIDOR: teal lane running north through zigzag zone -->
  <model name="floor_lane_S">
    <static>true</static><pose>0 -3.5 0.01 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>3.5 4.0 0.02</size></box></geometry>
        <material><ambient>0.15 0.45 0.50 1</ambient><diffuse>0.15 0.45 0.50 1</diffuse></material></visual>
    </link>
  </model>

  <!-- ZIGZAG CENTER: warm terracotta tile around center obstacle cluster -->
  <model name="floor_zigzag">
    <static>true</static><pose>0 0 0.01 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>10.0 3.5 0.02</size></box></geometry>
        <material><ambient>0.55 0.30 0.20 1</ambient><diffuse>0.55 0.30 0.20 1</diffuse></material></visual>
    </link>
  </model>

  <!-- CORRIDOR THROAT: bright yellow guide into narrow passage -->
  <model name="floor_corridor">
    <static>true</static><pose>0 3.5 0.01 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>4.0 4.0 0.02</size></box></geometry>
        <material><ambient>0.70 0.60 0.10 1</ambient><diffuse>0.70 0.60 0.10 1</diffuse></material></visual>
    </link>
  </model>

  <!-- GOAL ZONE: bright cyan arrival pad -->
  <model name="floor_goal_zone">
    <static>true</static><pose>0 6.8 0.01 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>7.0 2.0 0.02</size></box></geometry>
        <material><ambient>0.10 0.70 0.72 1</ambient><diffuse>0.10 0.70 0.72 1</diffuse></material></visual>
    </link>
  </model>

  <!-- STEP PLATFORM RAMP INDICATOR: orange zone showing terrain zone -->
  <model name="floor_terrain_zone">
    <static>true</static><pose>0 -4.2 0.01 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>5.0 1.5 0.02</size></box></geometry>
        <material><ambient>0.75 0.35 0.05 1</ambient><diffuse>0.75 0.35 0.05 1</diffuse></material></visual>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       PERIMETER WALLS — Arena: 20m (X:-10..+10) × 16m (Y:-8..+8)
       Each wall has a vivid colored panel on its interior face.
       ════════════════════════════════════════════════════════════════ -->

  <!-- SOUTH WALL — orange-red -->
  <model name="wall_south">
    <static>true</static><pose>0 -8 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>20.6 0.3 2.5</size></box></geometry>
        <material><ambient>0.30 0.30 0.30 1</ambient><diffuse>0.30 0.30 0.30 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>20.6 0.3 2.5</size></box></geometry></collision>
    </link>
  </model>
  <!-- South wall inner color panel: ORANGE-RED -->
  <model name="panel_south">
    <static>true</static><pose>0 -7.83 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>19.0 0.05 2.2</size></box></geometry>
        <material><ambient>0.90 0.35 0.10 1</ambient><diffuse>0.90 0.35 0.10 1</diffuse>
          <specular>0.3 0.1 0.05 1</specular></material></visual>
    </link>
  </model>

  <!-- NORTH WALL — steel blue -->
  <model name="wall_north">
    <static>true</static><pose>0 8 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>20.6 0.3 2.5</size></box></geometry>
        <material><ambient>0.28 0.28 0.32 1</ambient><diffuse>0.28 0.28 0.32 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>20.6 0.3 2.5</size></box></geometry></collision>
    </link>
  </model>
  <!-- North wall inner color panel: COBALT BLUE -->
  <model name="panel_north">
    <static>true</static><pose>0 7.83 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>19.0 0.05 2.2</size></box></geometry>
        <material><ambient>0.10 0.30 0.85 1</ambient><diffuse>0.10 0.30 0.85 1</diffuse>
          <specular>0.2 0.4 0.9 1</specular></material></visual>
    </link>
  </model>

  <!-- WEST WALL — dark -->
  <model name="wall_west">
    <static>true</static><pose>-10 0 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 16.6 2.5</size></box></geometry>
        <material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 16.6 2.5</size></box></geometry></collision>
    </link>
  </model>
  <!-- West wall inner color panel: LIME GREEN -->
  <model name="panel_west">
    <static>true</static><pose>-9.83 0 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.05 15.0 2.2</size></box></geometry>
        <material><ambient>0.20 0.78 0.22 1</ambient><diffuse>0.20 0.78 0.22 1</diffuse>
          <specular>0.1 0.5 0.1 1</specular></material></visual>
    </link>
  </model>

  <!-- EAST WALL — dark -->
  <model name="wall_east">
    <static>true</static><pose>10 0 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 16.6 2.5</size></box></geometry>
        <material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 16.6 2.5</size></box></geometry></collision>
    </link>
  </model>
  <!-- East wall inner color panel: VIOLET-MAGENTA -->
  <model name="panel_east">
    <static>true</static><pose>9.83 0 1.25 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.05 15.0 2.2</size></box></geometry>
        <material><ambient>0.65 0.15 0.72 1</ambient><diffuse>0.65 0.15 0.72 1</diffuse>
          <specular>0.4 0.05 0.5 1</specular></material></visual>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       SPAWN ZONE MARKERS — flanking the robot start position
       Bright yellow pylons the robot sees immediately on startup.
       ════════════════════════════════════════════════════════════════ -->
  <model name="spawn_post_L">
    <static>true</static><pose>-2.0 -7.0 0.6 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.95 0.90 0.05 1</ambient><diffuse>0.95 0.90 0.05 1</diffuse>
          <specular>0.6 0.6 0.1 1</specular></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry></collision>
    </link>
  </model>
  <model name="spawn_post_R">
    <static>true</static><pose>2.0 -7.0 0.6 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.95 0.90 0.05 1</ambient><diffuse>0.95 0.90 0.05 1</diffuse>
          <specular>0.6 0.6 0.1 1</specular></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.12</radius><length>1.2</length></cylinder></geometry></collision>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       ZONE 1 — APPROACH  (Y: -8 to -5)
       First visible obstacles from spawn + low terrain step
       ════════════════════════════════════════════════════════════════ -->

  <!-- Step platform: 10cm tall, 4m wide — exercises terrain_analysis_node -->
  <model name="step_platform">
    <static>true</static><pose>0 -4.2 0.05 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>4.0 1.0 0.10</size></box></geometry>
        <material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular></material></visual>
      <collision name="c"><geometry><box><size>4.0 1.0 0.10</size></box></geometry></collision>
    </link>
  </model>
  <!-- Step edge stripe — bright orange, helps YOLO + SLAM see it -->
  <model name="step_stripe">
    <static>true</static><pose>0 -4.2 0.105 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>4.0 0.08 0.01</size></box></geometry>
        <material><ambient>1.0 0.50 0.0 1</ambient><diffuse>1.0 0.50 0.0 1</diffuse></material></visual>
    </link>
  </model>

  <!-- Row 1 (y=-5): First decision point — off-center forces robot to choose -->
  <model name="obs_box_start">
    <static>true</static><pose>2.5 -5.0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
        <material><ambient>0.95 0.38 0.08 1</ambient><diffuse>0.95 0.38 0.08 1</diffuse>
          <specular>0.5 0.2 0.05 1</specular></material></visual>
      <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
    </link>
  </model>
  <!-- Mirror obstacle on left — forces bot into centre gap or left gap -->
  <model name="obs_box_L0">
    <static>true</static><pose>-2.5 -5.0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
        <material><ambient>0.55 0.12 0.75 1</ambient><diffuse>0.55 0.12 0.75 1</diffuse>
          <specular>0.3 0.05 0.5 1</specular></material></visual>
      <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
    </link>
  </model>

  <!-- ════════════════════════════════════════════════════════════════
       ZONE 2 — SLALOM  (Y: -5 to -1)
       Staggered gate pair + additional slalom pylons
       ════════════════════════════════════════════════════════════════ -->

  <!-- Gate pair (row y=-3) — wide enough for Nav2, forces planning -->
  <model name="obs_box_L1">
    <static>true</static><pose>-4.0 -3.0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.2 1.0 1.0</size></box></geometry>
        <material><ambient>0.95 0.82 0.08 1</ambient><diffuse>0.95 0.82 0.08 1</diffuse>
          <specular>0.5 0.45 0.1 1</specular></material></visual>
      <collision name="c"><geometry><box><size>1.2 1.0 1.0</size></box></geometry></collision>
    </link>
  </model>
  <model name="obs_box_R1">
    <static>true</static><pose>4.0 -3.0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>1.2 1.0 1.0</size></box></geometry>
        <material><ambient>0.95 0.82 0.08 1</ambient><diffuse>0.95 0.82 0.08 1</diffuse>
          <specular>0.5 0.45 0.1 1</specular></material></visual>
      <collision name="c"><geometry><box><size>1.2 1.0 1.0</size></box></geometry></collision>
    </link>
  </model>

  <!-- Mid-slalom pylons — staggered L/R to force sinusoidal path -->
  <model name="obs_cyl_slalom_L">
    <static>true</static><pose>-1.8 -4.0 0.6 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.05 0.55 0.90 1</ambient><diffuse>0.05 0.55 0.90 1</diffuse>
          <specular>0.1 0.4 0.7 1</specular></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry></collision>
    </link>
  </model>
  <model name="obs_cyl_slalom_R">
    <static>true</static><pose>1.8 -2.0 0.6 0 0 0</pose>
    <link name="link">
