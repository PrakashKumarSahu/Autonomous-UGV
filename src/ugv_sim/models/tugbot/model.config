<?xml version="1.0"?>
<!--
  model.config — required by Gazebo to discover this as a local model.
  
  The world SDF (tugbot_warehouse.sdf) references this model via:
    <uri>model://tugbot</uri>
  
  Gazebo resolves model:// URIs by searching GZ_SIM_RESOURCE_PATH for a directory
  named "tugbot" containing this model.config file. GZ_SIM_RESOURCE_PATH is set in
  sim.launch.py to include the ugv_sim install share directory first, so this local
  model takes precedence over the Fuel cache.
  
  IMPORTANT: Previously the world SDF used the Fuel URL directly:
    https://fuel.ignitionrobotics.org/1.0/MovAi/models/Tugbot
  This bypassed all local model.sdf changes. The URI was changed to model://tugbot
  to use this local modified version.
-->
<model>
  <name>tugbot</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <author>
    <name>Autonomous UGV Project</name>
    <email/>
  </author>
  <description>
    MovAI TugBot warehouse robot — locally modified for the Autonomous-UGV project.
    Key changes from the upstream Fuel model:
      - warnign_light_joint changed from revolute (spinning at 10 rad/s) to fixed
      - JointController plugin for warnign_light_joint removed
      - Gazebo sensors configured with always_on=1 for reliable data
    Original model: https://fuel.ignitionrobotics.org/1.0/MovAi/models/Tugbot
  </description>
</model>
