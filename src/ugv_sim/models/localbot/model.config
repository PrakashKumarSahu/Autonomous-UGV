<?xml version="1.0"?>
<!--
  Localbot model.config
  ─────────────────────
  Required by Gazebo Harmonic to discover this model directory via the model:// URI scheme.
  The world SDF references this model as:
    <uri>model://localbot</uri>
  Gazebo searches GZ_SIM_RESOURCE_PATH for a directory named "localbot" containing this file.
  GZ_SIM_RESOURCE_PATH is set in sim.launch.py to prioritise the ugv_sim install directory.

  Localbot is the project-native robot replacing the MovAI Fuel TugBot dependency.
  Key design goals:
    1. Zero Fuel/internet dependency — fully self-contained in this repo
    2. Joint names match URDF exactly (left_wheel_joint / right_wheel_joint)
       → no joint_state_relay name mapping needed, only QoS bridging
    3. Wheel physics (radius, separation) match URDF exactly
       → no more URDF↔SDF kinematic mismatch
    4. Only sensors used by the project (RGB cam, depth cam, IMU)
       → no unused gripper, lidar, charging-station plugins
    5. Simple box/cylinder geometry — zero external mesh dependencies
-->
<model>
  <name>localbot</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <author>
    <name>Autonomous UGV Project</name>
    <email/>
  </author>
  <description>
    Localbot — project-native differential-drive UGV for the Autonomous-UGV ROS 2 stack.
    Designed to replace the MovAI TugBot Fuel dependency with a fully local, maintainable model.
    Physical parameters match ugv_base.urdf.xacro exactly:
      chassis  : 0.6 x 0.4 x 0.2 m
      wheels   : radius=0.1 m, length=0.05 m, separation=0.45 m
      camera   : RGB + depth, positioned at (0.0553, 0, 0.4323) relative to base_link
      IMU      : at (0, 0, 0.11) relative to base_link top surface
    Sensors: RGB camera (30 Hz), depth_camera (30 Hz), IMU (50 Hz).
    Plugins: DiffDrive, JointStatePublisher (wheel joints only).
  </description>
</model>
