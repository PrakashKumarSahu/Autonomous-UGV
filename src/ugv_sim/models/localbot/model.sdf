<?xml version='1.0' encoding='ASCII'?>
<!--
  Localbot — Project-native Autonomous UGV robot model
  ═══════════════════════════════════════════════════════════════════════════════
  This is the SINGLE SOURCE OF TRUTH for the simulated robot's physical geometry,
  sensors, and controller plugins. It is loaded by Gazebo via model://localbot
  (resolved through GZ_SIM_RESOURCE_PATH set in sim.launch.py).

  DESIGN PRINCIPLES
  ─────────────────
  1. All physical parameters match ugv_base.urdf.xacro EXACTLY:
       base_length=0.6m  base_width=0.4m  base_height=0.2m
       wheel_radius=0.1m  wheel_length=0.05m  wheel_separation=0.45m
     This eliminates the TugBot URDF↔SDF mismatch (TugBot had radius=0.195m, sep=0.5605m).

  2. Joint names match URDF joint names EXACTLY:
       left_wheel_joint  →  continuous (not wheel_left_joint as in TugBot)
       right_wheel_joint →  continuous (not wheel_right_joint as in TugBot)
     The joint_state_relay node no longer needs name mapping, only QoS bridging.

  3. Only sensors used by the project stack are included:
       - RGB camera  (name="color") at camera_link
       - depth_camera (name="depth") at camera_link
       - IMU (name="imu") at imu_link
     No unused plugins (gripper, lidar, battery, warning-light, charging-station).

  4. Simple box/cylinder/sphere geometry — zero external mesh dependencies.

  COORDINATE CONVENTION
  ─────────────────────
  Model origin = base_footprint (virtual 2D projection at ground level).
  All link poses are expressed in the model frame (= base_footprint frame).
  At spawn time, the world SDF sets the model pose (z=0.01 so wheels clear ground).

  TOPIC NAMING (Gazebo Harmonic)
  ──────────────────────────────
  GZ auto-derives sensor topics from the model hierarchy:
    RGB  image  : /world/world_demo/model/localbot/link/camera_link/sensor/color/image
    RGB  info   : /world/world_demo/model/localbot/link/camera_link/sensor/color/camera_info
    Depth image : /world/world_demo/model/localbot/link/camera_link/sensor/depth/depth_image
    Depth info  : /world/world_demo/model/localbot/link/camera_link/sensor/depth/camera_info
    IMU data    : /world/world_demo/model/localbot/link/imu_link/sensor/imu/imu
    Joint state : /world/world_demo/model/localbot/joint_state
  DiffDrive plugin publishes to (Gazebo internal):
    Odometry: /model/localbot/odometry  →  bridged to /odometry/filtered
    TF      : /model/localbot/tf        →  bridged to /tf
    cmd_vel : /model/localbot/cmd_vel   ←  bridged from /cmd_vel
-->
<sdf version="1.7">
<model name="localbot">
  <self_collide>false</self_collide>
  <static>false</static>

  <!-- ══════════════════════════════════════════════════════════════════════
       LINKS
       All poses are in MODEL FRAME (= base_footprint frame, at ground level).
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- base_footprint: virtual ground-plane projection (zero-inertia link).
       The DiffDrive plugin uses this as child_frame_id for odometry.
       RSP uses base_footprint as the URDF root frame. -->
  <link name="base_footprint">
    <pose>0 0 0 0 0 0</pose>
    <inertial>
      <mass>0.0001</mass>
      <inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
               <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia>
    </inertial>
  </link>

  <!-- base_link: main chassis body.
       Positioned at wheel_radius + base_height/2 = 0.1 + 0.1 = 0.2 m above ground.
       Matches URDF: base_joint origin z = wheel_radius + base_height/2 = 0.2 m. -->
  <link name="base_link">
    <pose>0 0 0.2 0 0 0</pose>
    <inertial>
      <mass>15.0</mass>
      <!-- Solid box inertia: I = m/12 * (a² + b²) -->
      <inertia>
        <ixx>0.270833</ixx>  <!-- 15/12*(0.4²+0.2²) = 0.2708 -->
        <ixy>0</ixy><ixz>0</ixz>
        <iyy>0.508333</iyy>  <!-- 15/12*(0.6²+0.2²) = 0.5083 -->
        <iyz>0</iyz>
        <izz>0.625000</izz>  <!-- 15/12*(0.6²+0.4²) = 0.6250 -->
      </inertia>
    </inertial>
    <!-- Main chassis body: 0.6 × 0.4 × 0.2 m blue box -->
    <visual name="base_visual">
      <pose>0 0 0 0 0 0</pose>
      <geometry>
        <box><size>0.6 0.4 0.2</size></box>
      </geometry>
      <material>
        <ambient>0.1 0.1 0.5 1</ambient>   <!-- navy blue -->
        <diffuse>0.1 0.1 0.7 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
    <!-- Camera mast: thin vertical pole supporting the camera housing -->
    <visual name="mast_visual">
      <pose>0.0553 0 0.215 0 0 0</pose>  <!-- centered at mast midpoint -->
      <geometry>
        <box><size>0.04 0.04 0.43</size></box>
      </geometry>
      <material>
        <ambient>0.3 0.3 0.3 1</ambient>
        <diffuse>0.3 0.3 0.3 1</diffuse>
      </material>
    </visual>
    <!-- Collision uses single box (conservative, avoids thin geometry issues) -->
    <collision name="base_collision">
      <pose>0 0 0 0 0 0</pose>
      <geometry>
        <box><size>0.6 0.4 0.2</size></box>
      </geometry>
      <surface>
        <contact><ode/></contact>
        <friction>
          <ode><mu>0.3</mu><mu2>0.3</mu2></ode>
        </friction>
      </surface>
    </collision>
  </link>

  <!-- left_wheel_link: left drive wheel (cylinder, axis along model Y).
       Pose: y = +wheel_separation/2 = +0.225, z = wheel_radius = 0.1
       The cylinder geometry is along Z by default; visual rotated 90° to appear as a wheel. -->
  <link name="left_wheel_link">
    <pose>0 0.225 0.1 0 0 0</pose>
    <inertial>
      <mass>2.0</mass>
      <!-- Solid cylinder: Ixx=Iyy=m/12*(3r²+h²), Izz=mr²/2 -->
      <inertia>
        <ixx>0.008542</ixx>  <!-- 2/12*(3*0.01+0.0025) = 0.008542 -->
        <ixy>0</ixy><ixz>0</ixz>
        <iyy>0.008542</iyy>
        <iyz>0</iyz>
        <izz>0.010000</izz>  <!-- 0.5*2*0.01 = 0.01 -->
      </inertia>
    </inertial>
    <visual name="left_wheel_visual">
      <!-- Rotate cylinder 90° around X so it appears as a side-facing wheel -->
      <pose>0 0 0 1.5708 0 0</pose>
      <geometry>
        <cylinder><radius>0.1</radius><length>0.05</length></cylinder>
      </geometry>
      <material>
        <ambient>0.8 0.4 0.0 1</ambient>   <!-- orange wheels -->
        <diffuse>0.9 0.5 0.1 1</diffuse>
      </material>
    </visual>
    <collision name="left_wheel_collision">
      <pose>0 0 0 1.5708 0 0</pose>
      <geometry>
        <cylinder><radius>0.1</radius><length>0.05</length></cylinder>
      </geometry>
      <surface>
        <contact><ode>
          <kp>1000000.0</kp><kd>100.0</kd>
          <min_depth>0.001</min_depth>
        </ode></contact>
        <friction>
          <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
        </friction>
      </surface>
    </collision>
  </link>

  <!-- right_wheel_link: right drive wheel (mirror of left) -->
  <link name="right_wheel_link">
    <pose>0 -0.225 0.1 0 0 0</pose>
    <inertial>
      <mass>2.0</mass>
      <inertia>
        <ixx>0.008542</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.008542</iyy><iyz>0</iyz><izz>0.010000</izz>
      </inertia>
    </inertial>
    <visual name="right_wheel_visual">
      <pose>0 0 0 1.5708 0 0</pose>
      <geometry>
        <cylinder><radius>0.1</radius><length>0.05</length></cylinder>
      </geometry>
      <material>
        <ambient>0.8 0.4 0.0 1</ambient>
        <diffuse>0.9 0.5 0.1 1</diffuse>
      </material>
    </visual>
    <collision name="right_wheel_collision">
      <pose>0 0 0 1.5708 0 0</pose>
      <geometry>
        <cylinder><radius>0.1</radius><length>0.05</length></cylinder>
      </geometry>
      <surface>
        <contact><ode><kp>1000000.0</kp><kd>100.0</kd><min_depth>0.001</min_depth></ode></contact>
        <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
      </surface>
    </collision>
  </link>

  <!-- front_caster_wheel_link: front passive caster (low friction sphere).
       Located at front of chassis at x=base_length/2-0.08=0.22, z=caster_radius=0.05 -->
  <link name="front_caster_wheel_link">
    <pose>0.22 0 0.05 0 0 0</pose>
    <inertial>
      <mass>0.5</mass>
      <inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
      </inertia>
    </inertial>
    <visual name="front_caster_visual">
      <geometry>
        <sphere><radius>0.05</radius></sphere>
      </geometry>
      <material>
        <ambient>0.5 0.5 0.5 1</ambient>
        <diffuse>0.5 0.5 0.5 1</diffuse>
      </material>
    </visual>
    <collision name="front_caster_collision">
      <geometry>
        <sphere><radius>0.05</radius></sphere>
      </geometry>
      <surface>
        <contact><ode><kp>1000000.0</kp><kd>100.0</kd></ode></contact>
        <!-- Very low friction for free-rolling caster behavior -->
        <friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction>
      </surface>
    </collision>
  </link>

  <!-- rear_caster_wheel_link: rear passive caster -->
  <link name="rear_caster_wheel_link">
    <pose>-0.22 0 0.05 0 0 0</pose>
    <inertial>
      <mass>0.5</mass>
      <inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
      </inertia>
    </inertial>
    <visual name="rear_caster_visual">
      <geometry><sphere><radius>0.05</radius></sphere></geometry>
      <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
    </visual>
    <collision name="rear_caster_collision">
      <geometry><sphere><radius>0.05</radius></sphere></geometry>
      <surface>
        <contact><ode><kp>1000000.0</kp><kd>100.0</kd></ode></contact>
        <friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction>
      </surface>
    </collision>
  </link>

  <!-- camera_link: RGB + depth camera housing at top of mast.
       Pose matches URDF base_camera_joint:
         xyz = 0.0553 0 0.4323 relative to base_link
         In model frame: 0.0553 0 (0.2 + 0.4323) = 0.0553 0 0.6323
       Contains TWO Gazebo sensors:
         - "color"  : RGB camera    → publishes to .../sensor/color/image
         - "depth"  : depth_camera  → publishes to .../sensor/depth/depth_image
       Both use optical_frame_id = camera_link_optical (published by RSP from URDF). -->
  <link name="camera_link">
    <pose>0.0553 0 0.6323 0 0 0</pose>
    <inertial>
      <mass>0.1</mass>
      <inertia>
        <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
      </inertia>
    </inertial>
    <!-- Camera housing visual: small dark grey box -->
    <visual name="camera_visual">
      <pose>0 0 0 0 0 0</pose>
      <geometry>
        <box><size>0.03 0.10 0.03</size></box>
      </geometry>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.2 0.2 0.2 1</diffuse>
      </material>
    </visual>
    <collision name="camera_collision">
      <pose>0 0 0 0 0 0</pose>
      <geometry>
        <box><size>0.03 0.10 0.03</size></box>
      </geometry>
    </collision>

    <!-- ── RGB Camera sensor ──────────────────────────────────────────────────
         Sensor pose relative to camera_link: matches URDF camera_optical_joint
         origin (0, 0.0325, 0.0125) for the color module offset.
         FOV: 80° horizontal (1.3963 rad) = matches the depth sensor FOV.
         Resolution: 640×480 at 30 Hz.
         optical_frame_id: camera_link_optical (published by RSP from URDF). -->
    <sensor name="color" type="camera">
      <pose>0 0.0325 0.0125 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>25.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
        <!-- frame_id for published camera_info — must match URDF TF tree -->
        <optical_frame_id>camera_link_optical</optical_frame_id>
      </camera>
    </sensor>

    <!-- ── Depth Camera sensor ────────────────────────────────────────────────
         Gazebo Harmonic depth_camera publishes on:
           .../sensor/depth/depth_image  (32FC1, metres, NOT "image"!)
           .../sensor/depth/camera_info
         CRITICAL: The GZ topic suffix is "depth_image" not "image".
         This is verified in gazebo_bridge.yaml; changing it breaks SLAM.
         Range: 0.3 – 10 m (matching physical RGB-D sensors).
         Resolution matches RGB camera for synchronized stereo-like operation. -->
    <sensor name="depth" type="depth_camera">
      <pose>0 0.0175 0.0125 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.003</stddev>
        </noise>
        <optical_frame_id>camera_link_optical</optical_frame_id>
      </camera>
    </sensor>
  </link>

  <!-- imu_link: IMU sensor at top of chassis.
       Pose: 0 0 0.31 = 0.2(base_link) + 0.11(base_height/2 + 0.01).
       Matches URDF base_imu_joint: origin z = base_height/2 + 0.01 = 0.11 from base_link. -->
  <link name="imu_link">
    <pose>0 0 0.31 0 0 0</pose>
    <inertial>
      <mass>0.05</mass>
      <inertia>
        <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz>
      </inertia>
    </inertial>
    <visual name="imu_visual">
      <geometry><box><size>0.04 0.04 0.02</size></box></geometry>
      <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
    </visual>
    <!-- ── IMU sensor ──────────────────────────────────────────────────────── -->
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <frame_id>imu_link</frame_id>
    </sensor>
  </link>

  <!-- ══════════════════════════════════════════════════════════════════════
       JOINTS
       All joints use URDF-matching names so joint_state_relay needs NO
       name remapping — just QoS bridging (BestEffort → Reliable).
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- base_joint: rigidly connects base_footprint (virtual) → base_link (chassis) -->
  <joint name="base_joint" type="fixed">
    <parent>base_footprint</parent>
    <child>base_link</child>
  </joint>

  <!-- left_wheel_joint: left drive wheel revolute joint.
       Rotation axis = Y in MODEL FRAME (robot moves forward = wheel spins around Y).
       URDF: joint origin rpy="-pi/2 0 0", axis xyz="0 0 1" in child frame.
             Since child is rotated -90° around X, its Z = parent's Y → same effect.
       SDF:  axis xyz="0 1 0" in parent (base_link) frame = model Y = wheel axle. -->
  <joint name="left_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>left_wheel_link</child>
    <axis>
      <xyz>0 1 0</xyz>          <!-- wheel axle = model Y axis -->
      <limit>
        <effort>100</effort>
        <velocity>10</velocity>  <!-- ~1 m/s at r=0.1m -->
      </limit>
      <dynamics>
        <damping>0.5</damping>
        <friction>0.0</friction>
      </dynamics>
      <use_parent_model_frame>0</use_parent_model_frame>
    </axis>
  </joint>

  <!-- right_wheel_joint: right drive wheel revolute joint (mirror of left) -->
  <joint name="right_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>right_wheel_link</child>
    <axis>
      <xyz>0 1 0</xyz>
      <limit><effort>100</effort><velocity>10</velocity></limit>
      <dynamics><damping>0.5</damping><friction>0.0</friction></dynamics>
      <use_parent_model_frame>0</use_parent_model_frame>
    </axis>
  </joint>

  <!-- front_caster_wheel_joint: ball joint for passive caster (free rotation) -->
  <joint name="front_caster_wheel_joint" type="ball">
    <parent>base_link</parent>
    <child>front_caster_wheel_link</child>
  </joint>

  <!-- rear_caster_wheel_joint: ball joint for rear caster -->
  <joint name="rear_caster_wheel_joint" type="ball">
    <parent>base_link</parent>
    <child>rear_caster_wheel_link</child>
  </joint>

  <!-- base_camera_joint: rigidly mounts camera_link to chassis.
       Origin xyz="0.0553 0 0.4323" from base_link → MATCHES URDF base_camera_joint exactly. -->
  <joint name="base_camera_joint" type="fixed">
    <parent>base_link</parent>
    <child>camera_link</child>
  </joint>

  <!-- base_imu_joint: rigidly mounts IMU to chassis top.
       MATCHES URDF base_imu_joint: origin z = base_height/2 + 0.01 = 0.11 from base_link. -->
  <joint name="base_imu_joint" type="fixed">
    <parent>base_link</parent>
    <child>imu_link</child>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════════
       GAZEBO PLUGINS
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- ── Differential Drive Controller ─────────────────────────────────────
       Controls robot motion from /cmd_vel → wheel velocities → odometry.
       Physical parameters match ugv_base.urdf.xacro EXACTLY:
         wheel_separation = 0.45 m   (TugBot was 0.5605 m — now fixed)
         wheel_radius     = 0.1  m   (TugBot was 0.195  m — now fixed)
       DiffDrive publishes:
         /model/localbot/odometry → bridged to /odometry/filtered (ROS)
         /model/localbot/tf       → bridged to /tf (odom→base_footprint transform)
       DiffDrive subscribes:
         /model/localbot/cmd_vel  ← bridged from /cmd_vel (ROS) -->
  <plugin filename="ignition-gazebo-diff-drive-system"
          name="ignition::gazebo::systems::DiffDrive">
    <!-- Joint names MUST match the revolute joint names above (and URDF) -->
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.45</wheel_separation>
    <wheel_radius>0.1</wheel_radius>
    <odom_publish_frequency>20</odom_publish_frequency>
    <!-- Velocity limits (match ugv_base.urdf.xacro DiffDrive plugin) -->
    <max_linear_acceleration>2.0</max_linear_acceleration>
    <min_linear_acceleration>-2.0</min_linear_acceleration>
    <max_angular_acceleration>3.0</max_angular_acceleration>
    <min_angular_acceleration>-3.0</min_angular_acceleration>
    <max_linear_velocity>1.5</max_linear_velocity>
    <min_linear_velocity>-1.5</min_linear_velocity>
    <max_angular_velocity>2.0</max_angular_velocity>
    <min_angular_velocity>-2.0</min_angular_velocity>
    <!-- TF frame IDs published in /model/localbot/tf -->
    <frame_id>odom</frame_id>
    <child_frame_id>base_footprint</child_frame_id>
  </plugin>

  <!-- ── Joint State Publisher ──────────────────────────────────────────────
       Publishes wheel joint positions/velocities to /world/.../joint_state.
       ONLY wheel joints are published — no unused gripper/light joints.
       The GZ bridge maps this to /joint_states (ROS), then joint_state_relay
       does QoS bridging only (no name mapping needed since names match URDF). -->
  <plugin filename="ignition-gazebo-joint-state-publisher-system"
          name="ignition::gazebo::systems::JointStatePublisher">
    <joint_name>left_wheel_joint</joint_name>
    <joint_name>right_wheel_joint</joint_name>
  </plugin>

</model>
</sdf>
