<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />
    <xacro:property name="wheel_separation" value="0.45" />

    <!-- base_footprint is the 2D projection on the ground -->
    <link name="base_footprint" />

    <link name="base_link">
        <!-- Localbot chassis: 0.6 × 0.4 × 0.2 m navy-blue box.
             Matches Localbot model.sdf base_link visual exactly.
             No external mesh dependency — box geometry is self-contained. -->
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <material name="navy_blue">
                <color rgba="0.1 0.1 0.7 1.0" />
            </material>
        </visual>
        <!-- Camera mast visual: thin pole connecting chassis top to camera_link.
             Purely decorative — makes RViz match Gazebo appearance. -->
        <visual>
            <origin xyz="0.0553 0 0.215" rpy="0 0 0" />
            <geometry>
                <box size="0.04 0.04 0.43" />
            </geometry>
            <material name="dark_grey">
                <color rgba="0.3 0.3 0.3 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="15.0" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="${(15.0/12.0) * (base_width*base_width + base_height*base_height)}" ixy="0" ixz="0"
                     iyy="${(15.0/12.0) * (base_length*base_length + base_height*base_height)}" iyz="0"
                     izz="${(15.0/12.0) * (base_length*base_length + base_width*base_width)}" />
        </inertial>
    </link>


    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius + base_height / 2.0}" rpy="0 0 0" />
    </joint>

    <!-- Macro for Drive Wheels -->
    <xacro:macro name="wheel" params="prefix y_offset">
        <link name="${prefix}_wheel_link">
            <!-- Orange cylinder wheel — matches Localbot SDF wheel visual.
                 rpy rotates cylinder from default Z-axis to Y-axis (wheel axle direction). -->
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <material name="orange">
                    <color rgba="0.9 0.5 0.1 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="2.0" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="${(2.0/12.0)*(3*wheel_radius*wheel_radius + wheel_length*wheel_length)}" ixy="0" ixz="0"
                         iyy="${(2.0/12.0)*(3*wheel_radius*wheel_radius + wheel_length*wheel_length)}" iyz="0"
                         izz="${0.5 * 2.0 * wheel_radius * wheel_radius}" />
            </inertial>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link" />
            <child link="${prefix}_wheel_link" />
            <origin xyz="0 ${y_offset} ${-base_height / 2.0}" rpy="${-pi/2} 0 0" />
            <axis xyz="0 0 1" />
        </joint>

        <gazebo reference="${prefix}_wheel_link">
            <mu1>1.2</mu1>
            <mu2>1.2</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
        </gazebo>
    </xacro:macro>

    <xacro:wheel prefix="left" y_offset="${wheel_separation / 2.0}" />
    <xacro:wheel prefix="right" y_offset="${-wheel_separation / 2.0}" />

    <!-- Macro for Caster Wheels (Front & Rear) -->
    <xacro:macro name="caster" params="prefix x_offset">
        <link name="${prefix}_caster_wheel_link">
            <visual>
                <geometry>
                    <sphere radius="${wheel_radius / 2.0}" />
                </geometry>
                <material name="grey">
                    <color rgba="0.5 0.5 0.5 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius / 2.0}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.5" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
            </inertial>
        </link>

        <joint name="${prefix}_caster_wheel_joint" type="fixed">
            <parent link="base_link" />
            <child link="${prefix}_caster_wheel_link" />
            <origin xyz="${x_offset} 0 ${-base_height / 2.0 - wheel_radius / 2.0}" rpy="0 0 0" />
        </joint>

        <gazebo reference="${prefix}_caster_wheel_link">
            <mu1>0.05</mu1>
            <mu2>0.05</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:caster prefix="front" x_offset="${base_length / 2.0 - 0.08}" />
    <xacro:caster prefix="rear" x_offset="${-base_length / 2.0 + 0.08}" />

    <!-- ══════════════════════════════════════════════════════════════════════
         GAZEBO SIMULATION NOTE
         ══════════════════════════════════════════════════════════════════════
         Gazebo loads the robot from ugv_sim/models/localbot/model.sdf, NOT
         from this URDF. Gazebo plugins (DiffDrive, JointStatePublisher, sensors)
         are declared inside model.sdf.

         This URDF is used ONLY by robot_state_publisher to:
           1. Broadcast static TF transforms (base_footprint → base_link → camera_link → ...)
           2. Update dynamic joint TF from /joint_states_urdf (joint_state_relay)

         Do NOT add Gazebo simulation plugins here — they would be ignored since
         Gazebo is not loading the URDF. All simulation physics, sensors, and
         control are defined in ugv_sim/models/localbot/model.sdf.
         ══════════════════════════════════════════════════════════════════════ -->

</robot>
