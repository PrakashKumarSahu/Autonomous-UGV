Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /SLAMMap1
        - /LocalCostmap1
        - /CameraDepthCloud1
        - /RGBCamera1
      Splitter Ratio: 0.5
    Tree Height: 800
Visualization Manager:
  Class: ""
  Displays:
    # ── World Frame ────────────────────────────────────────────────────────────
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true

    # ── Robot Model ────────────────────────────────────────────────────────────
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true

    # ── TF (disabled by default, enable for debugging) ─────────────────────────
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false

    # ─────────────────────────────────────────────────────────────────────────
    # NAVIGATION MAPS
    # ─────────────────────────────────────────────────────────────────────────

    # SLAM occupancy map — built from real depth camera as robot explores.
    # Uses Transient Local QoS so late-joining RViz always gets latest map.
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: SLAMMap
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true

    # Local costmap — camera point cloud marks obstacles in real-time
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: LocalCostmap
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Value: true

    # Global costmap — RTAB-Map /map projected into Nav2 global frame
    - Alpha: 0.3
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: GlobalCostmap
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Value: true

    # ─────────────────────────────────────────────────────────────────────────
    # POINT CLOUDS
    # ─────────────────────────────────────────────────────────────────────────

    # Camera depth point cloud — what Nav2 uses for real-time obstacle avoidance
    # In sim mode: from Gazebo real depth sensor (metric ground-truth)
    # In hw mode:  from RealSense/ZED/Depth Anything (swappable)
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: 0
        Value: true
      Axis: Z
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 120; 30
      Color Transformer: FlatColor
      Decay Time: 0.3
      Enabled: true
      Name: CameraDepthCloud
      Position Transformer: XYZ
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/depth/points
      Value: true

    # RTAB-Map 3D accumulated cloud — the map being built from real depth
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: RTABMapCloud
      Position Transformer: XYZ
      Size (m): 0.03
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/cloud_map
      Value: true

    # ─────────────────────────────────────────────────────────────────────────
    # NAVIGATION PATHS
    # ─────────────────────────────────────────────────────────────────────────

    - Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: GlobalPlan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true

    - Class: rviz_default_plugins/Odometry
      Angle Tolerance: 0.1
      Color: 255; 255; 0
      Enabled: true
      Keep: 200
      Length: 0.3
      Name: OdometryTrail
      Position Tolerance: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
      Value: true

    # ─────────────────────────────────────────────────────────────────────────
    # CAMERA FEEDS
    # IMPORTANT QoS notes:
    #   - /camera/image_raw and /camera/depth/image_raw come from Gazebo bridge
    #     → MUST use Best Effort (Gazebo bridge publishes fire-and-forget)
    #   - /perception/depth/image_raw comes from depth_relay_node → Reliable
    #   - /perception/yolo/overlay comes from yolo_seg_node → Reliable
    #   - /perception/depth_ai/image_raw comes from depth_node → Reliable
    # ─────────────────────────────────────────────────────────────────────────

    # RGB camera from Gazebo (or real camera in hw mode)
    # BEST_EFFORT — Gazebo bridge publishes BestEffort, Reliable sub = no data
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RGBCamera
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
      Value: true

    # Real depth from Gazebo sensor relayed by depth_relay_node (32FC1, 0.1–10 m)
    # Min 0 / Max 10 shows full depth range; Normalize Range maps 0m=black, 10m=white
    # RELIABLE — depth_relay_node re-publishes as Reliable (QoS bridge from BestEffort Gz)
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 10
      Median window: 5
      Min Value: 0
      Name: RealDepth (Gazebo sensor / hw relay)
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/depth/image_raw
      Value: true

    # YOLO segmentation overlay — hazard detection visualization
    # RELIABLE — yolo_seg_node publishes Reliable (CPU/GPU node, not Gazebo bridge)
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: YOLOHazardOverlay
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/yolo/overlay
      Value: true

    # AI Depth visualization (only visible when enable_depth_viz:=true)
    # Shows Depth Anything V3 estimate — compare with RealDepth above
    # RELIABLE — depth_node (Depth Anything V3) publishes Reliable
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 10
      Median window: 5
      Min Value: 0
      Name: AIDepth (Depth Anything V3 — enable_depth_viz:=true)
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/depth_ai/image_raw
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: nav2_rviz_plugins/GoalTool
    - Class: nav2_rviz_plugins/NavThroughPosesTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Focal Shape Size: 0.05
      Focal Shape Type: Sphere
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.75
      Target Frame: base_footprint
      Value: Orbit (rviz)
      Yaw: 3.14
