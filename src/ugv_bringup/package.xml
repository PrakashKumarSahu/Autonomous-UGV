  <version>1.0.0</version>
  <description>Master orchestration and configuration package for Vision-Based Autonomous UGV</description>
  <maintainer email="prakashtech065@gmail.com">Prakash Kumar Sahu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ugv_description</exec_depend>
  <exec_depend>ugv_sim</exec_depend>
  <exec_depend>ugv_control</exec_depend>
  <exec_depend>ugv_perception</exec_depend>
  <exec_depend>ugv_terrain</exec_depend>
