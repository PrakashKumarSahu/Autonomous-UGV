# ══════════════════════════════════════════════════════════════════════════════
# docker/.env — Environment defaults for the DA V3 TRT Docker Compose stack
# ══════════════════════════════════════════════════════════════════════════════
# Copy / override these in your shell before running docker compose:
#   export ROS_DOMAIN_ID=5
#   docker compose -f docker/da3_trt.compose.yml up
#
# Or pass directly:
#   ROS_DOMAIN_ID=5 docker compose -f docker/da3_trt.compose.yml up
# ══════════════════════════════════════════════════════════════════════════════

# ROS 2 network configuration (must match the host UGV launch)
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# DA V3 Docker image (prebuilt, includes TRT + ROS 2 Jazzy + DA V3 node)
DA3_IMAGE=tillbeemelmanns/ros2-depth-anything-v3:latest-dev

# NVIDIA GPU selection (all = use all available GPUs)
NVIDIA_VISIBLE_DEVICES=all
